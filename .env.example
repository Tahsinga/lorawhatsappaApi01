# WhatsApp Cloud API settings
WA_PHONE_ID=your_meta_phone_number_id
WA_TOKEN=your_meta_access_token
WA_VERIFY_TOKEN=choose_a_webhook_verify_token
# Set this to a long random value in production.
DJANGO_SECRET_KEY=your_django_secret_key
# DEBUG defaults to true for local development; Render sets it to false.
DEBUG=true

# Optional: enables Meta webhook signature validation
# WA_APP_SECRET=your_meta_app_secret

# OpenAI-compatible model API key
MODEL_API_KEY=your_model_api_key
# MODEL_ID=gpt-4o-mini

# Lora web API stock lookup
WHATSAPP_STOCK_API_TOKEN=use_the_same_random_secret_as_the_lora_web_service
LORA_STOCK_API_URL=https://laxdomloraapi.onrender.com/api/whatsapp/stock/

# Optional: public HTTPS host for the WhatsApp Control Room (host only, no scheme)
# Set only when using a custom domain; Render's hostname is detected automatically.
# WHATSAPP_DASHBOARD_HOST=whatsapp.example.com